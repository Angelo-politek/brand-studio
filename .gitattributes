# Normalize line endings: LF in the repository, native in the working tree.
* text=auto eol=lf

# Windows-only scripts keep CRLF in the working tree.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary assets — never touched.
*.png binary
*.ico binary
*.jpg binary
*.webp binary
*.onnx binary
*.exe binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.mp4 binary
*.mp3 binary
*.wav binary
